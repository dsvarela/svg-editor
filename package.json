{
  "name": "svg-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A grid-based SVG path editor with direct manipulation and no command table.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "drive": "node tools/drive.mjs",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "playwright-core": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "path-bool": "^1.0.2"
  }
}
